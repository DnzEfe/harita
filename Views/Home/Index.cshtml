@{
    ViewData["Title"] = "Türkiye Haritası";
    Layout = "_Layout";
}

<!-- TASARIM (CSS) KODLARINI BURAYA YAPIŞTIRIYORUZ -->
<style>
    /* DIŞ KABUK: Yumuşak köşeler, zarif gölge ve temiz kenarlar */
    .esri-popup__main-container {
        border-radius: 16px !important;
        box-shadow: 0 12px 36px rgba(0,0,0,0.15) !important;
        border: none !important;
        font-family: 'Segoe UI', system-ui, sans-serif !important;
    }

    .esri-popup__header {
        background: #ffffff !important;
        border-bottom: 1px solid #f0f0f0 !important;
        padding: 16px 20px 10px 20px !important;
    }

    .esri-popup__header-title {
        color: #1e293b !important;
        font-weight: 800 !important;
        font-size: 17px !important;
    }

    .esri-popup__button {
        color: #94a3b8 !important;
    }

        .esri-popup__button:hover {
            background-color: #f1f5f9 !important;
            color: #0f172a !important;
            border-radius: 8px;
        }

    .esri-popup__content {
        margin: 0 !important;
        padding: 0 !important;
    }

    .esri-popup__footer {
        background: #f8fafc !important;
        border-top: 1px solid #f1f5f9 !important;
    }

    /* İÇERİK: JS dosyasından çağıracağımız özel satır ve rozet tasarımları */
    .ozel-popup-icerik {
        padding: 15px 20px;
        background: #ffffff;
    }

    .popup-satir {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px 0;
        border-bottom: 1px dashed #e2e8f0;
    }

        .popup-satir:last-child {
            border-bottom: none;
            padding-bottom: 0;
        }

    .popup-etiket {
        color: #64748b;
        font-size: 13px;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .popup-deger {
        color: #0f172a;
        font-size: 14px;
        font-weight: 700;
        text-align: right;
    }

    /* Dinamik Tesis Rozetleri (Badge) */
    .rozet {
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 800;
        color: white;
        letter-spacing: 0.5px;
    }

    .rozet-HES {
        background: linear-gradient(135deg, #0ea5e9, #2563eb);
    }

    .rozet-GES {
        background: linear-gradient(135deg, #f59e0b, #ea580c);
    }

    .rozet-RES {
        background: linear-gradient(135deg, #10b981, #059669);
    }

    .rozet-Termik {
        background: linear-gradient(135deg, #64748b, #334155);
    }
</style>

<div id="viewDiv" style="height:100vh; width:100vw;"></div>
<div id="coordDiv" style="
    position:fixed; bottom:10px; left:10px; z-index:999;
    background:white; padding:6px 10px; border-radius:4px;
    font-family:sans-serif; font-size:13px; box-shadow:0 1px 4px rgba(0,0,0,0.3);
    pointer-events:none;">
    Koordinat: --
</div>

@section Scripts {
    <script src="~/js/map.js"></script>
}